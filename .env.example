# ========================================================
# IWantYT — Optional Environment Configuration
# ========================================================

# YouTube PO (Proof of Origin) Token (Optional)
# Used to bypass YouTube bot detection on cloud/serverless IPs
PO_TOKEN=

# YouTube Cookies (Optional)
# Netscape format or raw cookie string (e.g. VISITOR_INFO1_LIVE=...; LOGIN_INFO=...)
YT_COOKIES=
